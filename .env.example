# انسخ هذا الملف إلى .env واملأ القيم الحقيقية
# انسخ بالأمر: cp .env.example .env

# ------- إعدادات السيرفر -------
PORT=3000
NODE_ENV=development
SITE_NAME=شركة مياه الشرب والصرف الصحي

# ------- إعدادات قاعدة البيانات (PostgreSQL) -------
PGHOST=localhost
PGPORT=5432
PGDATABASE=bwadc_db
PGUSER=bwadc_user
PGPASSWORD=change_this_password

# ------- إعدادات الجلسة (Session) -------
# غيّر هذا لأي نص عشوائي طويل وسري قبل النشر الحقيقي
SESSION_SECRET=change_this_to_a_long_random_secret_string

# ------- حساب المدير الافتراضي (يُستخدم مرة واحدة فقط عند التهيئة الأولى) -------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
