<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %> | لوحة التحكم</title>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@500;700;900&family=Almarai:wght@400;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="admin-body">
  <div class="admin-shell">
    <aside class="admin-sidebar">
      <div class="admin-sidebar-header">
        <div class="brand"><span class="brand-icon"><i class="bi bi-droplet-fill"></i></span><span class="brand-text">لوحة التحكم</span></div>
      </div>
      <nav>
        <a href="/admin"><i class="bi bi-grid-1x2-fill"></i> الرئيسية</a>
        <a href="/admin/news"><i class="bi bi-newspaper"></i> الأخبار</a>
        <a href="/admin/tenders"><i class="bi bi-file-earmark-text"></i> المناقصات</a>
        <a href="/admin/services"><i class="bi bi-grid-3x3-gap-fill"></i> الخدمات</a>
        <a href="/admin/statistics"><i class="bi bi-bar-chart-fill"></i> الإحصائيات</a>
        <a href="/admin/complaints"><i class="bi bi-chat-dots-fill"></i> الشكاوى</a>
        <a href="/admin/settings"><i class="bi bi-gear-fill"></i> إعدادات الموقع</a>
        <a href="/" target="_blank"><i class="bi bi-box-arrow-up-left"></i> عرض الموقع</a>
        <form action="/admin/logout" method="POST">
          <button type="submit" style="background:none;border:none;width:100%;text-align:right;padding:12px 20px;color:rgba(255,255,255,.85);font-weight:700;font-size:.9rem;cursor:pointer;display:flex;align-items:center;gap:10px;">
            <i class="bi bi-box-arrow-right"></i> تسجيل الخروج
          </button>
        </form>
      </nav>
    </aside>
    <main class="admin-main">
      <div class="admin-topbar">
        <h1><%= pageTitle %></h1>
        <% if (typeof currentAdmin !== 'undefined' && currentAdmin) { %>
          <span style="font-size:0.9rem;color:#666;"><i class="bi bi-person-circle"></i> <%= currentAdmin.full_name %></span>
        <% } %>
      </div>
