<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %> | <%= settings.site_name || 'شركة مياه الشرب والصرف الصحي' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@500;700;900&family=Almarai:wght@400;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

  <!-- الشريط العلوي -->
  <div class="top-bar">
    <div class="container top-bar-inner">
      <div class="top-bar-contact">
        <span><i class="bi bi-telephone-fill"></i> الخط الساخن: <%= settings.hotline || '125' %></span>
        <span class="d-none d-md-inline"><i class="bi bi-envelope-fill"></i> <%= settings.phone || '' %></span>
      </div>
      <div class="top-bar-social">
        <% if (settings.facebook_url) { %><a href="<%= settings.facebook_url %>" target="_blank" aria-label="فيسبوك"><i class="bi bi-facebook"></i></a><% } %>
        <% if (settings.whatsapp_url) { %><a href="<%= settings.whatsapp_url %>" target="_blank" aria-label="واتساب"><i class="bi bi-whatsapp"></i></a><% } %>
        <a href="/admin" aria-label="لوحة التحكم"><i class="bi bi-person-gear"></i> الدخول</a>
      </div>
    </div>
  </div>

  <!-- الهيدر الرئيسي -->
  <header class="main-header">
    <div class="container main-header-inner">
      <a href="/" class="brand">
        <span class="brand-icon"><i class="bi bi-droplet-fill"></i></span>
        <span class="brand-text"><%= settings.site_name || 'شركة مياه الشرب والصرف الصحي' %></span>
      </a>
      <nav class="main-nav">
        <button class="nav-toggle" id="navToggle" aria-label="فتح القائمة"><i class="bi bi-list"></i></button>
        <ul class="nav-list" id="navList">
          <li><a href="/">الرئيسية</a></li>
          <li><a href="/news">الأخبار</a></li>
          <li><a href="/tenders">المناقصات</a></li>
          <li><a href="/branches">الفروع</a></li>
          <li><a href="/complaints">شكاوى ومقترحات</a></li>
        </ul>
      </nav>
    </div>
  </header>
